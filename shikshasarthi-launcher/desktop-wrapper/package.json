{
  "name": "shikshasarthi-launcher",
  "version": "1.0.0",
  "description": "Desktop Launcher for ShikshaSarthi School Server",
  "repository": {
    "type": "git",
    "url": "https://github.com/S3labIITbh/ShikshaSarthi.git"
  },
  "homepage": "https://github.com/S3labIITbh/ShikshaSarthi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare:resources": "node ../../scripts/prepare-desktop-resources.cjs",
    "build": "npm run prepare:resources && electron-builder --win",
    "build:linux": "npm run prepare:resources && electron-builder --linux deb"
  },
  "author": "ShikshaSarthi <admin@shikshasarthi.com>",
  "license": "ISC",
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.shikshasarthi.launcher",
    "productName": "ShikshaSarthi",
    "publish": null,
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": ["deb"],
      "category": "Education"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "extraResources": [
      {
        "from": "launcher-data",
        "to": "launcher-data",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
