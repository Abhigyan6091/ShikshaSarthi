{
  "name": "shikshasarthi-launcher",
  "version": "1.0.20",
  "description": "Desktop Launcher for ShikshaSarthi School Server",
  "repository": {
    "type": "git",
    "url": "https://github.com/S3labIITbh/ShikshaSarthi.git"
  },
  "homepage": "https://github.com/S3labIITbh/ShikshaSarthi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare:resources": "node ../../scripts/prepare-desktop-resources.cjs",
    "build": "npm run prepare:resources && node ../../scripts/create-desktop-icons.cjs && electron-builder --win",
    "build:linux": "npm run prepare:resources && node ../../scripts/create-desktop-icons.cjs && electron-builder --linux deb"
  },
  "author": "ShikshaSarthi <admin@shikshasarthi.com>",
  "license": "ISC",
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.shikshasarthi.launcher",
    "productName": "ShikshaSarthi",
    "publish": null,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "license": "build/eula.txt",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "ShikshaSarthi",
      "uninstallDisplayName": "ShikshaSarthi",
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "extraResources": [
      {
        "from": "launcher-data",
        "to": "launcher-data",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
