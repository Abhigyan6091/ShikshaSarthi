{
  "name": "shikshasarthi-launcher",
  "version": "1.0.0",
  "description": "Desktop Launcher for ShikshaSarthi School Server",
  "repository": {
    "type": "git",
    "url": "https://github.com/S3labIITbh/ShikshaSarthi.git"
  },
  "homepage": "https://github.com/S3labIITbh/ShikshaSarthi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:linux": "electron-builder --linux deb"
  },
  "author": "ShikshaSarthi <admin@shikshasarthi.com>",
  "license": "ISC",
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.shikshasarthi.launcher",
    "productName": "ShikshaSarthi",
    "publish": null,
    "win": {
      "icon": "icon.ico",
      "target": "portable"
    },
    "linux": {
      "target": ["deb"],
      "category": "Education"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "extraResources": [
      {
        "from": "../../",
        "to": "launcher-data",
        "filter": [
          "**/*",
          "!.git/**/*",
          "!.env",
          "!backend/.env",
          "!node_modules/**/*",
          "!backend/node_modules/**/*",
          "!shikshasarthi-launcher/desktop-wrapper/node_modules/**/*",
          "!backend/backups/**/*",
          "!backend/uploads/**/*",
          "!backend/data/audio-cache/**/*",
          "!uploads/**/*",
          "!dist/**/*",
          "!dist-release/**/*",
          "!releases/**/*",
          "!shikshasarthi-launcher/data/**/*",
          "!QuestionGenerator/VQG/**/*",
          "!question_bank/textbooks/**/*"
        ]
      }
    ]
  }
}
